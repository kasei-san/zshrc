# zshrc.forwindows - Git Bash (bash 5.2) 用設定ファイル
#
# 使い方:
#   ~/.bashrc に以下の行を追加する
#   source ~/Dropbox/dotfiles/zshrc/zshrc.forwindows

#---------------------------------------------------------------------------
# 基本設定 {{{
#---------------------------------------------------------------------------
export LANG=ja_JP.UTF-8
export EDITOR=vim
# }}}

#---------------------------------------------------------------------------
# 履歴関係 {{{
#---------------------------------------------------------------------------
HISTFILE=~/.bash_history
HISTSIZE=100000
HISTFILESIZE=100000
HISTCONTROL=ignoredups:erasedups
shopt -s histappend
# }}}

#---------------------------------------------------------------------------
# color {{{
#---------------------------------------------------------------------------
export LS_COLORS='di=36:ln=35:so=32:pi=33:ex=31:bd=46;34:cd=43;34:su=41;30:sg=46;30:tw=42;30:ow=43;30'
# }}}

#---------------------------------------------------------------------------
# PROMPT {{{
#---------------------------------------------------------------------------
# __git_ps1 は /etc/profile.d/git-prompt.sh 経由で利用可能
if [ -f /etc/profile.d/git-prompt.sh ]; then
    source /etc/profile.d/git-prompt.sh
fi

GIT_PS1_SHOWDIRTYSTATE=true
GIT_PS1_SHOWUNTRACKEDFILES=true

__set_prompt() {
    local git_info
    git_info="$(__git_ps1 '(%s) ')"
    PS1="\[\e[1;32m\]${git_info}\[\e[1;33m\](aws:${AWS_PROFILE:-default})\[\e[0m\] \[\e[1;36m\]\[\e[4m\]\w%\[\e[0m\]\n\t \$ "
}
PROMPT_COMMAND=__set_prompt
# }}}

#---------------------------------------------------------------------------
# alias {{{
#---------------------------------------------------------------------------
alias ls='ls -hF --color=auto'
alias ll='ls -l --color=auto'

alias rm='rm -i'
# see : http://hamukazu.com/2014/02/24/why-grep-can-be-accelerated/
alias grep='LANG=C grep --color'

alias tailf='tail -f'

alias tf='terraform'
alias code='cursor'
alias open='explorer'
# }}}

#---------------------------------------------------------------------------
# git {{{
#---------------------------------------------------------------------------
alias g=git
alias gst='g st'
alias gdf='g df'
alias gbr='g br'
alias gvv='g vv'
alias gco='git checkout'
alias gci='g ci'
alias gad='g add'
alias gpo='git push origin'
alias git-delete-merged-branches='git branch --merged | grep -v master | xargs -I % git branch -d %'
alias gp='git pull --rebase --no-ff --prune && git-delete-merged-branches'
alias grh='git reset --hard'
# }}}
# vim:set foldmethod=marker:
